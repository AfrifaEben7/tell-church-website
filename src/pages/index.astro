---
import BaseLayout from "../layouts/BaseLayout.astro";

const site = {
  name: "TELL Church",
  street: "330 E. Anamosa St.",
  city: "Rapid City, SD 57701",
  mapUrl: "https://www.google.com/maps/search/?api=1&query=330+E+Anamosa+St+Rapid+City+SD+57701"
};

const navItems = [
  { label: "Sunday", href: "#sunday" },
  { label: "About", href: "#about" },
  { label: "Ministries", href: "#ministries" },
  { label: "Watch & Listen", href: "#messages" },
  { label: "Events", href: "#events" }
];

const ministries = [
  {
    name: "Children",
    description: "A safe, joyful place where children learn the Bible and know they are loved."
  },
  {
    name: "Youth",
    description: "Honest faith, strong friendships, and room for the next generation to lead."
  },
  {
    name: "Adults",
    description: "Grow through Scripture, prayer, fellowship, and meaningful relationships."
  },
  {
    name: "Outreach",
    description: "Put faith into action by serving our neighbors in Rapid City and beyond."
  }
];
---

<BaseLayout
  title="TELL Church | Word. Worship. Warmth."
  description="TELL Church is a welcoming, joyful and biblical community in Rapid City, South Dakota. Join us Sundays for fellowship, Sunday School and worship."
>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class="site-header" data-header>
    <div class="nav-shell">
      <a class="brand" href="#top" aria-label="TELL Church home">
        <img src="/images/tell-church-logo.png" alt="TELL Church" width="152" height="96" />
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
        <span class="sr-only">Open navigation</span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>

      <nav id="site-navigation" class="site-nav" aria-label="Primary navigation">
        <ul>
          {navItems.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
        <a class="button button--small button--primary" href="#give">Give</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section id="top" class="hero" aria-labelledby="hero-title">
      <img
        class="hero__image"
        src="/images/hero-worship.png"
        alt="A multicultural congregation lifting their hands together during worship"
        width="2048"
        height="1152"
        fetchpriority="high"
      />
      <div class="hero__veil" aria-hidden="true"></div>
      <div class="hero__content">
        <p class="hero__phrase">Word. Worship. Warmth.</p>
        <h1 id="hero-title">Welcome Home</h1>
        <p class="hero__lead">Sundays in Rapid City</p>
        <div class="hero__actions">
          <a class="button button--primary" href="#sunday">Plan a Visit</a>
          <a class="button button--outline-light" href="#messages">Watch Online</a>
        </div>
      </div>
    </section>

    <section id="sunday" class="welcome section" aria-labelledby="welcome-title">
      <div class="welcome__message">
        <p class="section-label">Your Sunday starts here</p>
        <h2 id="welcome-title">You belong here.</h2>
        <p>
          Whether you have followed Jesus for years, have questions about faith, or are simply
          looking for a church to call home, there is a place for you at TELL Church.
        </p>
      </div>

      <div class="sunday-details" aria-label="Sunday schedule and location">
        <div class="detail-row">
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
          <div>
            <time datetime="11:30">11:30 AM</time>
            <span>Fellowship &amp; Sunday School</span>
          </div>
        </div>
        <div class="detail-row">
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
          <div>
            <time datetime="12:30">12:30 PM</time>
            <span>Worship Service</span>
          </div>
        </div>
        <a class="detail-row detail-row--link" href={site.mapUrl} target="_blank" rel="noreferrer">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
          <address>
            <span>{site.street}</span>
            <span>{site.city}</span>
          </address>
        </a>
      </div>
    </section>

    <section id="messages" class="message-section section section--mint" aria-labelledby="message-title">
      <div class="message-section__copy">
        <p class="section-label">Watch latest teaching</p>
        <h2 id="message-title">A faith you can live.</h2>
        <p>
          Biblical teaching for everyday life—clear, hopeful, and centered on Jesus. Our online
          sermon library is being prepared and will be connected here soon.
        </p>
        <p class="status-note"><span aria-hidden="true"></span> Message archive coming soon</p>
      </div>
      <figure class="message-media">
        <img
          src="/images/latest-message.png"
          alt="A pastor sharing a biblical message from the stage"
          width="1600"
          height="900"
          loading="lazy"
        />
        <figcaption>Teaching rooted in Scripture and made for real life.</figcaption>
      </figure>
    </section>

    <section id="about" class="manifesto section" aria-labelledby="manifesto-title">
      <div>
        <p class="section-label">Life at TELL Church</p>
        <h2 id="manifesto-title">Word.<br />Worship.<br />Warmth.</h2>
      </div>
      <div class="manifesto__body">
        <p class="manifesto__lead">Come encounter God’s Word, worship with freedom, and find a community that feels like family.</p>
        <p>
          We are a joyful, multicultural church where every generation can grow in faith, discover
          purpose, and take a next step with Jesus.
        </p>
        <a class="text-link" href="#ministries">Find your next step <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section id="ministries" class="ministries section section--dark" aria-labelledby="ministries-title">
      <div class="ministries__intro">
        <p class="section-label section-label--light">Growing together</p>
        <h2 id="ministries-title">There is room for every generation.</h2>
        <p>Faith grows through people who know your name, pray with you, and walk beside you.</p>
      </div>
      <div class="ministry-list">
        {ministries.map((ministry) => (
          <article>
            <h3>{ministry.name}</h3>
            <p>{ministry.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="events" class="visit section" aria-labelledby="visit-title">
      <div class="visit__heading">
        <p class="section-label">Come this Sunday</p>
        <h2 id="visit-title">Your seat is waiting.</h2>
      </div>
      <div class="visit__details">
        <p>
          Start with fellowship and Sunday School at 11:30 AM, then stay for worship at 12:30 PM.
          Come as you are—we would love to meet you.
        </p>
        <a class="button button--primary" href={site.mapUrl} target="_blank" rel="noreferrer">Get Directions</a>
      </div>
    </section>

    <section id="give" class="giving section" aria-labelledby="give-title">
      <div>
        <p class="section-label section-label--light">Generosity at TELL</p>
        <h2 id="give-title">Give with purpose.</h2>
      </div>
      <div class="giving__copy">
        <p>
          Your generosity supports ministry, outreach, and the work of sharing the hope of Jesus.
          Secure one-time and recurring online giving will open here after our nonprofit checkout
          verification is complete.
        </p>
        <p class="giving__status">Online giving setup in progress</p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-footer__brand">
      <img src="/images/tell-church-logo.png" alt="" width="132" height="84" loading="lazy" />
      <p>Word. Worship. Warmth.</p>
    </div>
    <div>
      <h2>Join us Sunday</h2>
      <p>11:30 AM · Fellowship &amp; Sunday School</p>
      <p>12:30 PM · Worship Service</p>
    </div>
    <div>
      <h2>Find us</h2>
      <address>{site.street}<br />{site.city}</address>
      <a class="text-link text-link--light" href={site.mapUrl} target="_blank" rel="noreferrer">Open in Maps <span aria-hidden="true">→</span></a>
    </div>
    <p class="site-footer__legal">© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
  </footer>

  <script>
    const header = document.querySelector("[data-header]");
    const toggle = document.querySelector(".menu-toggle");
    const nav = document.querySelector("#site-navigation");

    const closeMenu = () => {
      if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;
      header.dataset.open = "false";
      toggle.setAttribute("aria-expanded", "false");
      const label = toggle.querySelector(".sr-only");
      if (label) label.textContent = "Open navigation";
    };

    toggle?.addEventListener("click", () => {
      if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;
      const nextOpen = toggle.getAttribute("aria-expanded") !== "true";
      header.dataset.open = String(nextOpen);
      toggle.setAttribute("aria-expanded", String(nextOpen));
      const label = toggle.querySelector(".sr-only");
      if (label) label.textContent = nextOpen ? "Close navigation" : "Open navigation";
    });

    nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu();
        if (toggle instanceof HTMLButtonElement) toggle.focus();
      }
    });
  </script>
</BaseLayout>
