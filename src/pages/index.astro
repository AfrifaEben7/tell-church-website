---
import BaseLayout from "../layouts/BaseLayout.astro";
import church from "../content/church.json";
import homepage from "../content/homepage.json";
import giving from "../content/giving.json";

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.startsWith("/") ? path : `/${path}`}`;

const navItems = [
  { label: "Sunday", href: "#sunday" },
  { label: "About", href: "#about" },
  { label: "Ministries", href: "#ministries" },
  { label: "Watch & Listen", href: "#messages" },
  { label: "Events", href: "#events" }
];

---

<BaseLayout
  title="TELL Church | Word. Worship. Warmth."
  description="TELL Church is a welcoming, joyful and biblical community in Rapid City, South Dakota. Join us Sundays for fellowship, Sunday School and worship."
>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class="site-header" data-header>
    <div class="nav-shell">
      <a class="brand" href="#top" aria-label="TELL Church home">
        <img src={asset(church.logo)} alt={church.name} width="152" height="96" />
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
        <span class="sr-only">Open navigation</span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>

      <nav id="site-navigation" class="site-nav" aria-label="Primary navigation">
        <ul>
          {navItems.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
        <a class="button button--small button--primary" href={`${base}/give/`}>Give</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section id="top" class="hero" aria-labelledby="hero-title">
      <img
        class="hero__image"
        src={asset(church.heroImage)}
        alt="A multicultural congregation lifting their hands together during worship"
        width="2048"
        height="1152"
        fetchpriority="high"
      />
      <div class="hero__veil" aria-hidden="true"></div>
      <div class="hero__content">
        <p class="hero__phrase">{church.slogan}</p>
        <h1 id="hero-title">{homepage.heroTitle}</h1>
        <p class="hero__lead">{homepage.currentHeroLead}</p>
        <div class="hero__actions">
          <a class="button button--primary" href="#sunday">Plan a Visit</a>
          <a class="button button--outline-light" href="#messages">Watch Online</a>
        </div>
      </div>
    </section>

    <section id="sunday" class="welcome section" aria-labelledby="welcome-title">
      <div class="welcome__message">
        <p class="section-label">Your Sunday starts here</p>
        <h2 id="welcome-title">{homepage.welcomeTitle}</h2>
        <p>{homepage.welcomeBody}</p>
      </div>

      <div class="sunday-details" aria-label="Sunday schedule and location">
        <div class="detail-row">
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
          <div>
            <time datetime="11:30">{church.fellowshipTime}</time>
            <span>{church.fellowshipLabel}</span>
          </div>
        </div>
        <div class="detail-row">
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
          <div>
            <time datetime="12:30">{church.worshipTime}</time>
            <span>{church.worshipLabel}</span>
          </div>
        </div>
        <a class="detail-row detail-row--link" href={church.mapUrl} target="_blank" rel="noreferrer">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
          <address>
            <span>{church.street}</span>
            <span>{church.city}</span>
          </address>
        </a>
      </div>
    </section>

    <section id="messages" class="message-section section section--mint" aria-labelledby="message-title">
      <div class="message-section__copy">
        <p class="section-label">Watch latest teaching</p>
        <h2 id="message-title">{homepage.currentMessageTitle}</h2>
        <p>{homepage.currentMessageBody}</p>
        <p class="status-note"><span aria-hidden="true"></span> {homepage.messageStatus}</p>
      </div>
      <figure class="message-media">
        <img
          src={asset(church.messageImage)}
          alt="A pastor sharing a biblical message from the stage"
          width="1600"
          height="900"
          loading="lazy"
        />
        <figcaption>{homepage.messageCaption}</figcaption>
      </figure>
    </section>

    <section id="about" class="manifesto section" aria-labelledby="manifesto-title">
      <div>
        <p class="section-label">Life at TELL Church</p>
        <h2 id="manifesto-title">{church.slogan.split(" ").map((word) => <>{word}<br /></>)}</h2>
      </div>
      <div class="manifesto__body">
        <p class="manifesto__lead">{homepage.aboutLead}</p>
        <p>{homepage.aboutBody}</p>
        <a class="text-link" href="#ministries">Find your next step <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section id="ministries" class="ministries section section--dark" aria-labelledby="ministries-title">
      <div class="ministries__intro">
        <p class="section-label section-label--light">Growing together</p>
        <h2 id="ministries-title">{homepage.ministriesTitle}</h2>
        <p>{homepage.ministriesBody}</p>
      </div>
      <div class="ministry-list">
        {homepage.ministries.map((ministry) => (
          <article>
            <h3>{ministry.name}</h3>
            <p>{ministry.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="events" class="visit section" aria-labelledby="visit-title">
      <div class="visit__heading">
        <p class="section-label">Come this Sunday</p>
        <h2 id="visit-title">{homepage.visitTitle}</h2>
      </div>
      <div class="visit__details">
        <p>{homepage.visitBody}</p>
        <a class="button button--primary" href={church.mapUrl} target="_blank" rel="noreferrer">Get Directions</a>
      </div>
    </section>

    <section id="give" class="giving section" aria-labelledby="give-title">
      <div>
        <p class="section-label section-label--light">Generosity at TELL</p>
        <h2 id="give-title">{giving.heroTitle}</h2>
      </div>
      <div class="giving__copy">
        <p>{giving.heroBody}</p>
        <p class="giving__status">{giving.status}</p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-footer__brand">
      <img src={asset(church.logo)} alt="" width="132" height="84" loading="lazy" />
      <p>{church.slogan}</p>
    </div>
    <div>
      <h2>Join us Sunday</h2>
      <p>{church.fellowshipTime} · {church.fellowshipLabel}</p>
      <p>{church.worshipTime} · {church.worshipLabel}</p>
    </div>
    <div>
      <h2>Find us</h2>
      <address>{church.street}<br />{church.city}</address>
      <a class="text-link text-link--light" href={church.mapUrl} target="_blank" rel="noreferrer">Open in Maps <span aria-hidden="true">→</span></a>
    </div>
    <p class="site-footer__legal">© {new Date().getFullYear()} {church.name}. All rights reserved.</p>
  </footer>

  <script>
    const header = document.querySelector("[data-header]");
    const toggle = document.querySelector(".menu-toggle");
    const nav = document.querySelector("#site-navigation");

    const closeMenu = () => {
      if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;
      header.dataset.open = "false";
      toggle.setAttribute("aria-expanded", "false");
      const label = toggle.querySelector(".sr-only");
      if (label) label.textContent = "Open navigation";
    };

    toggle?.addEventListener("click", () => {
      if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;
      const nextOpen = toggle.getAttribute("aria-expanded") !== "true";
      header.dataset.open = String(nextOpen);
      toggle.setAttribute("aria-expanded", String(nextOpen));
      const label = toggle.querySelector(".sr-only");
      if (label) label.textContent = nextOpen ? "Close navigation" : "Open navigation";
    });

    nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu();
        if (toggle instanceof HTMLButtonElement) toggle.focus();
      }
    });
  </script>
</BaseLayout>
