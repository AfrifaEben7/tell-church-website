---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/give.css";
import church from "../content/church.json";
import giving from "../content/giving.json";

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.startsWith("/") ? path : `/${path}`}`;
const homeUrl = `${base}/`;
const previewUrl = `${base}/pastor-preview/`;
---

<BaseLayout
  title="Give | TELL Church"
  description="Learn about giving at TELL Church and the secure online giving options being prepared."
  bodyClass="give-body"
>
  <a class="skip-link" href="#give-main">Skip to main content</a>

  <div class="give-preview-note">
    <span>{giving.paymentsActive ? "Online giving is active" : "Payments are not active"}</span>
    <a href={previewUrl}>View alternate homepage</a>
  </div>

  <header class="give-header">
    <a href={homeUrl} aria-label="TELL Church home">
      <img src={asset(church.logo)} alt={church.name} width="150" height="96" />
    </a>
    <nav aria-label="Giving page navigation">
      <a href={homeUrl}>Home</a>
      <a href="#ways">Ways to Give</a>
      <a href="#questions">Questions</a>
    </nav>
  </header>

  <main id="give-main">
    <section class="give-hero">
      <div class="give-hero__copy">
        <p class="give-kicker">Generosity at TELL</p>
        <h1>{giving.heroTitle}</h1>
        <p>{giving.heroBody}</p>
      </div>
      <aside class="give-launch" aria-labelledby="launch-title">
        <span class="give-launch__status">{giving.status}</span>
        <h2 id="launch-title">{giving.cardTitle}</h2>
        <p>{giving.cardBody}</p>
        {giving.paymentsActive && giving.givingUrl ? (
          <a class="give-launch__button" href={giving.givingUrl} target="_blank" rel="noreferrer">{giving.buttonLabel}</a>
        ) : (
          <span class="give-launch__button" aria-disabled="true">{giving.buttonLabel}</span>
        )}
        <small>{giving.safetyNote}</small>
      </aside>
    </section>

    <section class="give-scripture" aria-label="Giving statement">
      <p>“{giving.scripture}”</p>
      <cite>{giving.scriptureReference}</cite>
    </section>

    <section id="ways" class="ways-to-give" aria-labelledby="ways-title">
      <div class="ways-to-give__intro">
        <h2 id="ways-title">Ways to give</h2>
        <p>{giving.waysIntro}</p>
      </div>

      <div class="giving-methods">
        <article>
          <span class="method-number">01</span>
          <div>
            <h3>Give online</h3>
            <p>{giving.onlineText}</p>
            <ul>
              <li>Apple Pay and Google Pay</li>
              <li>Credit or debit card</li>
              <li>ACH bank transfer</li>
            </ul>
          </div>
        </article>
        <article>
          <span class="method-number">02</span>
          <div>
            <h3>Give in person</h3>
            <p>{giving.inPersonText}</p>
          </div>
        </article>
        <article>
          <span class="method-number">03</span>
          <div>
            <h3>Give by mail</h3>
            <address>{church.name}<br />{church.street}<br />{church.city}</address>
          </div>
        </article>
        <article>
          <span class="method-number">04</span>
          <div>
            <h3>Other gifts</h3>
            <p>{giving.otherText}</p>
          </div>
        </article>
      </div>
    </section>

    <section id="questions" class="give-help">
      <div>
        <h2>{giving.helpTitle}</h2>
        <p>{giving.helpText}</p>
      </div>
      <a href={homeUrl}>Return to TELL Church</a>
    </section>
  </main>

  <footer class="give-footer">
    <p>© {new Date().getFullYear()} {church.name}</p>
    <p>{church.slogan}</p>
  </footer>
</BaseLayout>
