---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pastor-preview.css";

const base = import.meta.env.BASE_URL;
const homeUrl = `${base}/`;
const giveUrl = `${base}/give/`;
const mapUrl = "https://www.google.com/maps/search/?api=1&query=330+E+Anamosa+St+Rapid+City+SD+57701";

const nextSteps = [
  { title: "Plan a Visit", text: "We can’t wait to meet you.", icon: "people" },
  { title: "Grow in Faith", text: "Explore classes and groups.", icon: "leaf" },
  { title: "Get Connected", text: "Find your people.", icon: "heart" },
  { title: "Make a Difference", text: "Serve in your community.", icon: "hand" }
];
---

<BaseLayout
  title="TELL Church | Pastor Preview"
  description="An alternate homepage concept for TELL Church in Rapid City, South Dakota."
  bodyClass="concept-body"
>
  <a class="skip-link" href="#concept-main">Skip to main content</a>

  <div class="preview-strip">
    <span>Alternate homepage</span>
    <a href={homeUrl}>View current design</a>
  </div>

  <header class="concept-header" data-concept-header>
    <a class="concept-logo" href={homeUrl} aria-label="TELL Church home">
      <img src={`${base}/images/tell-church-logo.png`} alt="TELL Church" width="150" height="96" />
    </a>
    <button class="concept-menu" type="button" aria-expanded="false" aria-controls="concept-nav">
      <span class="sr-only">Open navigation</span>
      <span></span><span></span>
    </button>
    <nav id="concept-nav" class="concept-nav" aria-label="Preview navigation">
      <a href="#sunday">New Here</a>
      <a href="#welcome">About</a>
      <a href="#next-steps">Ministries</a>
      <a href="#latest-message">Sermons</a>
      <a href="#next-steps">Events</a>
      <a class="concept-give" href={giveUrl}>Give</a>
    </nav>
  </header>

  <main id="concept-main">
    <section class="concept-hero" aria-labelledby="concept-title">
      <img
        src={`${base}/images/hero-worship.png`}
        alt="A multicultural congregation worshiping together"
        width="2048"
        height="1152"
        fetchpriority="high"
      />
      <div class="concept-hero__shade"></div>
      <div class="concept-hero__content">
        <h1 id="concept-title">Welcome Home</h1>
        <p class="concept-hero__lead">There’s a place for you here.</p>
        <p>Come for the Word. Lift your voice in worship.<br />Find warmth in community.</p>
        <div class="concept-actions">
          <a class="concept-button concept-button--solid" href="#sunday">Plan a Visit</a>
          <a class="concept-button concept-button--outline" href="#latest-message">Watch Online</a>
        </div>
      </div>
    </section>

    <section id="sunday" class="sunday-rail" aria-label="Sunday information">
      <p class="sunday-rail__motto">Word.<br />Worship.<br />Warmth.</p>
      <div class="sunday-rail__title">
        <span class="rail-icon" aria-hidden="true">▦</span>
        <strong>Sundays<br />at TELL</strong>
      </div>
      <div class="sunday-rail__times">
        <p><span aria-hidden="true">◷</span><strong>11:30 AM</strong> — Fellowship &amp; Sunday School</p>
        <p><span aria-hidden="true">◷</span><strong>12:30 PM</strong> — Worship Service</p>
      </div>
      <a class="sunday-rail__place" href={mapUrl} target="_blank" rel="noreferrer">
        <span aria-hidden="true">⌖</span>
        <strong>330 E. Anamosa St. · Rapid City, SD</strong>
      </a>
    </section>

    <section id="welcome" class="concept-welcome">
      <div>
        <h2>You belong here.</h2>
        <p>
          TELL Church is a joyful, multicultural family growing through Scripture, worship, and
          life together. Come as you are and take your next step with Jesus.
        </p>
      </div>
      <blockquote>“Word that shapes us. Worship that lifts us. Warmth that welcomes us.”</blockquote>
    </section>

    <section class="concept-lower">
      <article id="latest-message" class="latest-message">
        <h2>Latest Message</h2>
        <div class="latest-message__body">
          <img
            src={`${base}/images/latest-message.png`}
            alt="A pastor sharing a message from the stage"
            width="800"
            height="450"
            loading="lazy"
          />
          <div>
            <h3>Living with Purpose</h3>
            <p>A study in Ephesians 2:10</p>
            <span>Message library coming soon</span>
          </div>
        </div>
      </article>

      <section id="next-steps" class="next-steps" aria-labelledby="next-title">
        <h2 id="next-title">Take Your Next Step</h2>
        <div class="next-steps__list">
          {nextSteps.map((step) => (
            <article>
              <span class={`step-icon step-icon--${step.icon}`} aria-hidden="true"></span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    </section>

    <section class="concept-visit">
      <div>
        <h2>Join us this Sunday.</h2>
        <p>Fellowship begins at 11:30 AM. Worship begins at 12:30 PM.</p>
      </div>
      <a class="concept-button concept-button--solid" href={mapUrl} target="_blank" rel="noreferrer">Get Directions</a>
    </section>
  </main>

  <footer class="concept-footer">
    <img src={`${base}/images/tell-church-logo.png`} alt="TELL Church" width="130" height="82" loading="lazy" />
    <p>330 E. Anamosa St. · Rapid City, SD 57701</p>
    <a href={giveUrl}>Giving page preview</a>
  </footer>

  <script>
    const header = document.querySelector("[data-concept-header]");
    const menu = document.querySelector(".concept-menu");
    const nav = document.querySelector("#concept-nav");

    const close = () => {
      if (!(header instanceof HTMLElement) || !(menu instanceof HTMLButtonElement)) return;
      header.dataset.open = "false";
      menu.setAttribute("aria-expanded", "false");
    };

    menu?.addEventListener("click", () => {
      if (!(header instanceof HTMLElement) || !(menu instanceof HTMLButtonElement)) return;
      const open = menu.getAttribute("aria-expanded") !== "true";
      header.dataset.open = String(open);
      menu.setAttribute("aria-expanded", String(open));
    });
    nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));
    document.addEventListener("keydown", (event) => event.key === "Escape" && close());
  </script>
</BaseLayout>
